# ── Stage 1 : Tailwind CSS build ──────────────────────────────────────
FROM node:20-alpine AS css-builder
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY tailwind.config.js ./
COPY app/static/css/input.css ./
COPY app/templates/ ./app/templates/
COPY app/static/js/ ./app/static/js/
RUN npx tailwindcss -i input.css -o tailwind.min.css --minify

# ── Stage 2 : Flask panel ──────────────────────────────────────────────
FROM python:3.11-slim@sha256:cdbd05fb6f457ca275ff51ce00d93d865ca0b6a25f5ffb08262d94f6835771e5

# Bibliothèques 32-bit pour SteamCMD (binaire i386)
RUN dpkg --add-architecture i386 \
 && apt-get update \
 && apt-get install -y --no-install-recommends libc6:i386 libstdc++6:i386 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /panel

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
COPY --from=css-builder /build/tailwind.min.css /panel/app/static/css/tailwind.min.css
# Code lisible par le compte panel quels que soient les droits de l'archive ou de l'extraction
# (une extraction en umask 077 laisserait run.py lisible par root seul)
RUN chmod -R a+rX /panel

ARG GIT_HASH=unknown
# Utilisateur sans droits qui fait tourner le panel (entrypoint.sh : le conteneur démarre en root
# le temps de lui donner ses dossiers, puis le panel tourne sous ce compte). Le code reste à root.
# uid et gid fixes à 1000 : un gid « système » attribué au hasard (999…) tombe sur un groupe de
# l'hôte (systemd-journal sous Debian) pour les fichiers des dossiers montés.
RUN groupadd --gid 1000 panel && \
    useradd --uid 1000 --gid 1000 --home-dir /home/panel --create-home \
        --shell /usr/sbin/nologin panel && \
    mkdir -p /panel/data /panel/logs /aceserver/configs && \
    chown panel:panel /panel/data /panel/logs && \
    echo "${GIT_HASH}" > /panel/.git_hash && \
    pybabel compile -d /panel/translations && \
    chmod +x /panel/entrypoint.sh

ENV DEPLOY_MODE=docker_split \
    ACESERVER_DIR=/aceserver \
    CONFIGS_DIR=/aceserver/configs \
    DATABASE_URL=sqlite:////panel/data/ace_evo.db \
    ACESERVER_CONTAINER_NAME=ace-server \
    ACESERVER_HOST=ace-server \
    PYTHONUNBUFFERED=1

ARG PANEL_PORT=4300
EXPOSE ${PANEL_PORT}

ENTRYPOINT ["/panel/entrypoint.sh"]
