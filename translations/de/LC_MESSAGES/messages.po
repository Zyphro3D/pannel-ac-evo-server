#: app/routes/admin.py:577
msgid "Nom affiché dans la sidebar"
msgstr "Im Seitenmenü angezeigter Name"

#: app/routes/admin.py:578
msgid "Nom de fichier dans media/banner/ (ex: banner.jpg)"
msgstr "Dateiname in media/banner/ (z. B. banner.jpg)"

#: app/routes/admin.py:579
msgid "Logo sur la bannière (ex: logo.png)"
msgstr "Logo auf dem Banner (z. B. logo.png)"

#: app/routes/admin.py:580
msgid "URL publique du panel (liens dans les emails)"
msgstr "Öffentliche Panel-URL (Links in E-Mails)"

#: app/routes/admin.py:581
msgid "Fuseau horaire (ex: Europe/Paris)"
msgstr "Zeitzone (z. B. Europe/Paris)"

#: app/routes/admin.py:582
msgid ""
"Clé de session Flask — générer avec python -c \"import secrets; "
"print(secrets.token_hex(32))\""
msgstr ""
"Flask-Session-Schlüssel — generieren mit python -c \"import secrets; "
"print(secrets.token_hex(32))\""

#: app/routes/admin.py:583
msgid "true si HTTPS, false si HTTP local"
msgstr "true bei HTTPS, false bei lokalem HTTP"

#: app/routes/admin.py:584
msgid "Secret HMAC du webhook résultats (/api/results/ingest)"
msgstr "HMAC-Secret für den Ergebnis-Webhook (/api/results/ingest)"

#: app/routes/admin.py:585
msgid ""
"Exige que les pilotes confirment leur email (lien envoyé à l'inscription)"
" avant de pouvoir s'inscrire à un événement. Les comptes existants ne "
"sont pas affectés rétroactivement."
msgstr ""
"Verlangt von Fahrern, ihre E-Mail zu bestätigen (Link bei der "
"Registrierung gesendet), bevor sie sich für eine Veranstaltung anmelden "
"können. Bestehende Konten sind nicht rückwirkend betroffen."

#: app/routes/admin.py:586
msgid ""
"Nombre de mois de conservation détaillée de l'historique des tours "
"(temps, voiture, circuit). Au-delà, archivé en résumé mensuel compact "
"plutôt que supprimé."
msgstr ""
"Anzahl der Monate, für die die detaillierte Rundenhistorie (Zeit, Auto, "
"Strecke) aufbewahrt wird. Danach wird sie als kompakte monatliche "
"Zusammenfassung archiviert statt gelöscht."

#: app/routes/admin.py:587
msgid "Port HTTP de l'API du serveur (défaut 8081)"
msgstr "HTTP-Port der Server-API (Standard 8081)"

#: app/routes/admin.py:588
msgid "Hôte TCP ACE EVO (défaut 127.0.0.1)"
msgstr "ACE EVO TCP-Host (Standard 127.0.0.1)"

#: app/routes/admin.py:589
msgid "Port TCP ACE EVO (défaut 9700)"
msgstr "ACE EVO TCP-Port (Standard 9700)"

#: app/routes/admin.py:590
msgid "Dossier d'installation ACE EVO"
msgstr "ACE EVO Installationsordner"

#: app/routes/admin.py:591
msgid "Dossier des fichiers de configuration JSON"
msgstr "Ordner für JSON-Konfigurationsdateien"

#: app/routes/admin.py:592
msgid ""
"Nom du serveur affiché dans la liste des serveurs ACE EVO (commun à "
"toutes les configs)"
msgstr "Servername in der ACE-EVO-Serverliste (für alle Konfigurationen gleich)"

#: app/routes/admin.py:593
msgid "Nombre maximum de joueurs simultanés (1–128, défaut 8)"
msgstr "Maximale Anzahl gleichzeitiger Spieler (1–128, Standard 8)"

#: app/routes/admin.py:594
msgid ""
"Port TCP du serveur de jeu (défaut 9700) — doit correspondre aux règles "
"firewall"
msgstr ""
"TCP-Port des Spielservers (Standard 9700) — muss mit den Firewall-Regeln "
"übereinstimmen"

#: app/routes/admin.py:595
msgid ""
"Port UDP du serveur de jeu (défaut 9700) — généralement identique au port"
" TCP"
msgstr ""
"UDP-Port des Spielservers (Standard 9700) — normalerweise identisch mit "
"dem TCP-Port"

#: app/routes/admin.py:596
msgid ""
"Mot de passe d'accès au serveur pour les pilotes. Laisser vide = accès "
"libre"
msgstr "Serverzugangspasswort für Fahrer. Leer lassen = freier Zugang"

#: app/routes/admin.py:597
msgid ""
"Mot de passe admin serveur (commandes /kick, /next, etc.) — utilisé aussi"
" par le bot TCP"
msgstr ""
"Server-Admin-Passwort (/kick-, /next-Befehle usw.) — wird auch vom TCP-"
"Bot verwendet"

#: app/routes/admin.py:598
msgid "Chemin vers le fichier entry_list.ini (laisser vide si non utilisé)"
msgstr "Pfad zur Datei entry_list.ini (leer lassen, falls nicht verwendet)"

#: app/routes/admin.py:599
msgid ""
"Dossier de sortie des résultats de session (laisser vide = dossier par "
"défaut)"
msgstr "Ausgabeordner für Sitzungsergebnisse (leer lassen = Standardordner)"

#: app/routes/admin.py:600
msgid ""
"Steam ID 64-bit du compte bot — le bot se connecte au serveur avec ce "
"compte. Laisser vide pour désactiver le bot."
msgstr ""
"64-Bit-Steam-ID des Bot-Kontos — der Bot verbindet sich mit diesem Konto "
"zum Server. Leer lassen, um den Bot zu deaktivieren."

#: app/routes/admin.py:601
msgid "Voiture utilisée par le bot pour rejoindre la session."
msgstr "Fahrzeug, das der Bot zum Beitreten der Session verwendet."

#: app/routes/admin.py:602
msgid ""
"Activer les droits admin pour le bot (true/false). Le mot de passe est lu"
" automatiquement depuis la config serveur active."
msgstr ""
"Admin-Rechte für den Bot aktivieren (true/false). Das Passwort wird "
"automatisch aus der aktiven Serverkonfiguration gelesen."

#: app/routes/admin.py:603
#, python-brace-format
msgid ""
"Message de bienvenue envoyé à chaque connexion. Variable : {name}. "
"Laisser vide pour désactiver."
msgstr ""
"Willkommensnachricht bei jeder Verbindung. Variable: {name}. Leer lassen "
"zum Deaktivieren."

#: app/routes/admin.py:604
#, python-brace-format
msgid ""
"Message Discord envoyé si DISCORD_INVITE_URL est défini. Variables : "
"{name}, {discord_url}. Laisser vide pour désactiver."
msgstr ""
"Discord-Nachricht, gesendet wenn DISCORD_INVITE_URL gesetzt ist. "
"Variablen: {name}, {discord_url}. Leer lassen zum Deaktivieren."

#: app/routes/admin.py:605
#, python-brace-format
msgid ""
"Message site envoyé si PANEL_URL est défini. Variables : {name}, "
"{site_url}. Laisser vide pour désactiver."
msgstr ""
"Website-Nachricht, gesendet wenn PANEL_URL gesetzt ist. Variablen: "
"{name}, {site_url}. Leer lassen zum Deaktivieren."

#: app/routes/admin.py:606
msgid ""
"Pré-remplit le formulaire de mise à jour. Le mot de passe est saisi au "
"moment de la mise à jour, jamais stocké."
msgstr ""
"Füllt das Update-Formular vor. Das Passwort wird zum Zeitpunkt des "
"Updates eingegeben, nie gespeichert."

#: app/routes/admin.py:607
msgid "Webhook principal — démarrage, arrêt, crash du serveur"
msgstr "Haupt-Webhook — Serverstart, -stopp, Absturz"

#: app/routes/admin.py:608
msgid "Webhook pilotes — connexions, déconnexions, changements de véhicule"
msgstr "Fahrer-Webhook — Verbindungen, Trennungen, Fahrzeugwechsel"

#: app/routes/admin.py:609
msgid "Webhook course — meilleur tour, actions admin (kick, pénalités…)"
msgstr "Rennen-Webhook — Bestzeit, Admin-Aktionen (Kick, Strafen…)"

#: app/routes/admin.py:610
msgid ""
"Envoie sur le webhook course un récapitulatif à la fin de chaque session "
": podium, meilleur tour, incidents et sanctions (true/false, désactivé "
"par défaut)."
msgstr ""
"Sendet am Ende jeder Sitzung eine Zusammenfassung an den Rennen-Webhook: "
"Podium, schnellste Runde, Vorfälle und Strafen (true/false, standardmäßig"
" aus)."

#: app/routes/admin.py:611
msgid "Lien d'invitation Discord affiché sur le panel"
msgstr "Discord-Einladungslink, angezeigt im Panel"

#: app/routes/admin.py:612
msgid ""
"Mention envoyée avec les événements serveur (ex: @here ou <@&123456789>)."
" Laisser vide pour désactiver."
msgstr ""
"Erwähnung bei Server-Ereignissen (z. B. @here oder <@&123456789>). Leer "
"lassen zum Deaktivieren."

#: app/routes/admin.py:613
msgid "Mention envoyée avec les connexions joueurs. Laisser vide pour désactiver."
msgstr "Erwähnung bei Spielerverbindungen. Leer lassen zum Deaktivieren."

#: app/routes/admin.py:614
msgid "Mention envoyée avec les événements course. Laisser vide pour désactiver."
msgstr "Erwähnung bei Renn-Ereignissen. Leer lassen zum Deaktivieren."

#: app/routes/admin.py:615
#, python-brace-format
msgid "Titre embed — Serveur démarré. Variables : {config}, {mode}, {circuit}"
msgstr "Embed-Titel — Server gestartet. Variablen: {config}, {mode}, {circuit}"

#: app/routes/admin.py:616
#, python-brace-format
msgid "Titre embed — Serveur arrêté. Variables : {config}"
msgstr "Embed-Titel — Server gestoppt. Variablen: {config}"

#: app/routes/admin.py:617
#, python-brace-format
msgid "Titre embed — Crash détecté. Variables : {config}"
msgstr "Embed-Titel — Absturz erkannt. Variablen: {config}"

#: app/routes/admin.py:618
#, python-brace-format
msgid ""
"Titre embed — Connexion joueur. Variables : {name}, {num}, {car}, "
"{steam_id}"
msgstr ""
"Embed-Titel — Spielerverbindung. Variablen: {name}, {num}, {car}, "
"{steam_id}"

#: app/routes/admin.py:619
#, python-brace-format
msgid ""
"Titre embed — Déconnexion joueur. Variables : {name}, {duration}, "
"{steam_id}"
msgstr "Embed-Titel — Spielertrennung. Variablen: {name}, {duration}, {steam_id}"

#: app/routes/admin.py:620
#, python-brace-format
msgid ""
"Titre embed — Changement de véhicule. Variables : {name}, {num}, "
"{old_car}, {new_car}"
msgstr ""
"Embed-Titel — Fahrzeugwechsel. Variablen: {name}, {num}, {old_car}, "
"{new_car}"

#: app/routes/admin.py:621
#, python-brace-format
msgid ""
"Titre embed — Meilleur tour serveur. Variables : {name}, {lap}, {car}, "
"{circuit}"
msgstr "Embed-Titel — Server-Bestzeit. Variablen: {name}, {lap}, {car}, {circuit}"

#: app/routes/admin.py:622
#, python-brace-format
msgid ""
"Titre embed — Action admin. Variables : {action}, {target}, {admin}, "
"{detail}"
msgstr ""
"Embed-Titel — Admin-Aktion. Variablen: {action}, {target}, {admin}, "
"{detail}"

#: app/routes/admin.py:623
#, python-brace-format
msgid "Titre embed — Fin de session. Variables : {session}, {circuit}"
msgstr "Embed-Titel — Sitzungsende. Variablen: {session}, {circuit}"

#: app/routes/admin.py:624
msgid "Serveur SMTP (laisser vide pour désactiver les emails)"
msgstr "SMTP-Server (leer lassen, um E-Mails zu deaktivieren)"

#: app/routes/admin.py:625
msgid "Port SMTP (ex: 587 ou 465)"
msgstr "SMTP-Port (z. B. 587 oder 465)"

#: app/routes/admin.py:626
msgid "TLS : true ou false"
msgstr "TLS: true oder false"

#: app/routes/admin.py:627
msgid "Identifiant SMTP"
msgstr "SMTP-Benutzername"

#: app/routes/admin.py:628
msgid "Mot de passe SMTP"
msgstr "SMTP-Passwort"

#: app/routes/admin.py:629
msgid "Adresse expéditeur"
msgstr "Absenderadresse"

#: app/routes/admin.py:630
msgid "Adresse(s) admin pour les notifications (séparées par virgule)"
msgstr "Admin-Adresse(n) für Benachrichtigungen (durch Komma getrennt)"

#: app/routes/admin.py:631
msgid "Langue par défaut : fr, en, es, de, it"
msgstr "Standardsprache: fr, en, es, de, it"

#: app/routes/admin.py:684
msgid ""
"Contrôle d'accès au serveur de jeu (liste blanche des pilotes approuvés, "
"bannissements, lest et restricteur par SteamID) : se règle dans la page "
"Accès, désactivé par défaut."
msgstr ""
"Zugriffskontrolle für den Spielserver (Whitelist freigegebener Fahrer, "
"Sperren, Ballast und Restriktor pro SteamID): einzustellen auf der Seite "
"Zugriff, standardmäßig aus."

#: app/routes/admin.py:685
msgid ""
"Réserve le serveur aux pilotes approuvés (page Accès, désactivé par "
"défaut)."
msgstr ""
"Reserviert den Server für freigegebene Fahrer (Seite Zugriff, "
"standardmäßig aus)."

#: app/routes/admin.py:688
msgid ""
"Récapitulatif Discord à la fin de chaque session (podium, meilleur tour, "
"incidents, sanctions) : interrupteur dans Paramètres → Notifications, "
"désactivé par défaut."
msgstr ""
"Discord-Zusammenfassung am Ende jeder Sitzung (Podium, schnellste Runde, "
"Vorfälle, Strafen): Schalter unter Einstellungen → Benachrichtigungen, "
"standardmäßig aus."

#: app/routes/admin.py:691
msgid ""
"Dossier de session Steam à monter si le panel est lancé via systemd ou "
"sudo sans -E (sinon ça reste vide et $HOME est utilisé, comme avant)."
msgstr ""
"Zu bindender Steam-Sitzungsordner, falls das Panel über systemd oder sudo"
" ohne -E gestartet wird (sonst bleibt es leer und $HOME wird wie zuvor "
"verwendet)."

#: app/routes/admin.py:848 app/routes/admin.py:1244
msgid "Port invalide (1024–65535)."
msgstr "Ungültiger Port (1024–65535)."

#: app/routes/admin.py:850
#, python-format
msgid "Le port %(port)d est déjà utilisé par '%(name)s'."
msgstr "Port %(port)d wird bereits von '%(name)s' verwendet."

#: app/routes/admin.py:878 app/routes/admin.py:879
msgid "Paramètres du serveur sauvegardés."
msgstr "Servereinstellungen gespeichert."

#: app/routes/admin.py:915 app/routes/admin.py:916
msgid "Paramètres sauvegardés"
msgstr "Einstellungen gespeichert"

#: app/routes/admin.py:973 app/routes/admin.py:1512
msgid "Aucun fichier fourni"
msgstr "Keine Datei angegeben"

#: app/routes/admin.py:982
msgid "Fichier trop volumineux (max 5 Mo)"
msgstr "Datei zu groß (max. 5 MB)"

#: app/routes/admin.py:985
msgid "Type non autorisé"
msgstr "Nicht erlaubter Typ"

#: app/routes/admin.py:996
msgid "Signature de fichier invalide"
msgstr "Ungültige Dateisignatur"

#: app/routes/admin.py:1027
msgid "Identifiant et mot de passe requis."
msgstr "Benutzername und Passwort erforderlich."

#: app/routes/admin.py:1032 app/routes/admin.py:1063
msgid "Cet identifiant est déjà utilisé."
msgstr "Dieser Benutzername ist bereits vergeben."

#: app/routes/admin.py:1038
msgid "Compte créé avec succès."
msgstr "Konto erfolgreich erstellt."

#: app/routes/admin.py:1048 app/routes/admin.py:1099
msgid "Compte introuvable."
msgstr "Konto nicht gefunden."

#: app/routes/admin.py:1059 app/routes/admin.py:1147
msgid "Impossible : il doit rester au moins un superadmin actif."
msgstr "Unmöglich: Es muss mindestens ein aktiver Superadmin verbleiben."

#: app/routes/admin.py:1071
msgid "Compte mis à jour."
msgstr "Konto aktualisiert."

#: app/routes/admin.py:1081 app/routes/admin.py:1133
msgid "Compte introuvable"
msgstr "Konto nicht gefunden"

#: app/routes/admin.py:1085
msgid "Dernier superadmin actif — impossible de désactiver"
msgstr "Letzter aktiver Superadmin — kann nicht deaktiviert werden"

#: app/routes/admin.py:1087
msgid "Impossible de vous désactiver vous-même"
msgstr "Sie können sich nicht selbst deaktivieren"

#: app/routes/admin.py:1102 app/routes/admin.py:1136
msgid "Impossible de supprimer votre propre compte."
msgstr "Sie können Ihr eigenes Konto nicht löschen."

#: app/routes/admin.py:1107 app/routes/admin.py:1140
msgid "Impossible : il doit rester au moins un superadmin."
msgstr "Unmöglich: Es muss mindestens ein Superadmin verbleiben."

#: app/routes/admin.py:1111
msgid "Compte supprimé."
msgstr "Konto gelöscht."

#: app/routes/admin.py:1127
msgid "Rôle invalide"
msgstr "Ungültige Rolle"

#: app/routes/admin.py:1156
msgid "Pilote introuvable"
msgstr "Fahrer nicht gefunden"

#: app/routes/admin.py:1161
msgid ""
"Cet identifiant est déjà utilisé par un compte admin — renomme le pilote "
"ou l'admin existant."
msgstr ""
"Dieser Name wird bereits von einem Admin-Konto verwendet — benenne den "
"Fahrer oder den bestehenden Admin um."

#: app/routes/admin.py:1174
msgid "Requête invalide"
msgstr "Ungültige Anfrage"

#: app/routes/admin.py:1194 app/routes/public.py:214
msgid "Cet email est déjà utilisé."
msgstr "Diese E-Mail-Adresse wird bereits verwendet."

#: app/routes/admin.py:1198
msgid "Email mis à jour."
msgstr "E-Mail aktualisiert."

#: app/routes/admin.py:1242 app/routes/admin.py:1331
msgid "Le nom est requis."
msgstr "Name ist erforderlich."

#: app/routes/admin.py:1246
#, python-format
msgid "Le port %(port)d est déjà utilisé par un autre serveur."
msgstr "Port %(port)d wird bereits von einem anderen Server verwendet."

#: app/routes/admin.py:1248
#, python-format
msgid "Un container Docker nommé '%(name)s' existe déjà."
msgstr "Ein Docker-Container namens '%(name)s' existiert bereits."

#: app/routes/admin.py:1271
#, python-format
msgid "Erreur lors de la création du container : %(err)s"
msgstr "Fehler beim Erstellen des Containers: %(err)s"

#: app/routes/admin.py:1295
#, python-format
msgid "Serveur '%(name)s' créé avec succès."
msgstr "Server '%(name)s' erfolgreich erstellt."

#: app/routes/admin.py:1304
msgid "Le serveur principal ne peut pas être désactivé."
msgstr "Der Hauptserver kann nicht deaktiviert werden."

#: app/routes/admin.py:1307 app/routes/admin.py:1328 app/routes/admin.py:1363
msgid "Serveur introuvable."
msgstr "Server nicht gefunden."

#: app/routes/admin.py:1310
#, python-format
msgid "Serveur '%(name)s' activé."
msgstr "Server '%(name)s' aktiviert."

#: app/routes/admin.py:1310
#, python-format
msgid "Serveur '%(name)s' désactivé."
msgstr "Server '%(name)s' deaktiviert."

#: app/routes/admin.py:1342
#, python-format
msgid ""
"Serveur renommé en '%(name)s'. Le nom affiché dans le navigateur de "
"serveurs du jeu ne sera mis à jour qu'au prochain redémarrage."
msgstr ""
"Server umbenannt in '%(name)s'. Der im Server-Browser des Spiels "
"angezeigte Name wird erst beim nächsten Neustart aktualisiert."

#: app/routes/admin.py:1360
msgid "Le serveur principal ne peut pas être supprimé."
msgstr "Der Hauptserver kann nicht gelöscht werden."

#: app/routes/admin.py:1383 app/routes/admin.py:1384
#, python-format
msgid "Serveur '%(name)s' supprimé."
msgstr "Server '%(name)s' gelöscht."

#: app/routes/admin.py:1509
msgid "Fichier trop volumineux (max 3 Go)"
msgstr "Datei zu groß (max. 3 GB)"

#: app/routes/admin.py:1532 app/routes/admin.py:1545
msgid "Mod introuvable"
msgstr "Mod nicht gefunden"

#: app/routes/admin.py:1551 app/routes/admin.py:1553 app/routes/admin.py:1555
msgid "Tag invalide"
msgstr "Ungültiger Tag"

#: app/routes/admin.py:1561
msgid "PI invalide"
msgstr "Ungültiger PI-Wert"

#: app/routes/auth.py:64
msgid "Le mot de passe doit contenir au moins 10 caractères."
msgstr "Das Passwort muss mindestens 10 Zeichen enthalten."

#: app/routes/auth.py:66
msgid "Le mot de passe doit contenir au moins une majuscule."
msgstr "Das Passwort muss mindestens einen Großbuchstaben enthalten."

