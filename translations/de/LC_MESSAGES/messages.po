#: app/routes/admin.py:432
msgid ""
"Aucun fichier de configuration trouvé dans CONFIGS_DIR. Créez-en un via "
"le bouton ci-dessous."
msgstr ""
"Keine Konfigurationsdatei in CONFIGS_DIR gefunden. Erstellen Sie eine "
"über die Schaltfläche unten."

#: app/routes/admin.py:442
#, python-format
msgid ""
"Fichier de configuration invalide (%(name)s) : erreur JSON ligne %(line)s"
" colonne %(col)s. Corrigez et sauvegardez depuis l'onglet Configuration."
msgstr ""
"Ungültige Konfigurationsdatei (%(name)s): JSON-Fehler in Zeile %(line)s, "
"Spalte %(col)s. Korrigieren und im Tab Konfiguration speichern."

