#: app/routes/admin.py:577
msgid "Nom affiché dans la sidebar"
msgstr "Nome visualizzato nella barra laterale"

#: app/routes/admin.py:578
msgid "Nom de fichier dans media/banner/ (ex: banner.jpg)"
msgstr "Nome file in media/banner/ (es: banner.jpg)"

#: app/routes/admin.py:579
msgid "Logo sur la bannière (ex: logo.png)"
msgstr "Logo sul banner (es: logo.png)"

#: app/routes/admin.py:580
msgid "URL publique du panel (liens dans les emails)"
msgstr "URL pubblico del pannello (link nelle email)"

#: app/routes/admin.py:581
msgid "Fuseau horaire (ex: Europe/Paris)"
msgstr "Fuso orario (es: Europe/Paris)"

#: app/routes/admin.py:582
msgid ""
"Clé de session Flask — générer avec python -c \"import secrets; "
"print(secrets.token_hex(32))\""
msgstr ""
"Chiave di sessione Flask — generare con python -c \"import secrets; "
"print(secrets.token_hex(32))\""

#: app/routes/admin.py:583
msgid "true si HTTPS, false si HTTP local"
msgstr "true se HTTPS, false se HTTP locale"

#: app/routes/admin.py:584
msgid "Secret HMAC du webhook résultats (/api/results/ingest)"
msgstr "Segreto HMAC del webhook risultati (/api/results/ingest)"

#: app/routes/admin.py:585
msgid ""
"Exige que les pilotes confirment leur email (lien envoyé à l'inscription)"
" avant de pouvoir s'inscrire à un événement. Les comptes existants ne "
"sont pas affectés rétroactivement."
msgstr ""
"Richiede che i piloti confermino la propria email (link inviato alla "
"registrazione) prima di potersi iscrivere a un evento. Gli account "
"esistenti non sono interessati retroattivamente."

#: app/routes/admin.py:586
msgid ""
"Nombre de mois de conservation détaillée de l'historique des tours "
"(temps, voiture, circuit). Au-delà, archivé en résumé mensuel compact "
"plutôt que supprimé."
msgstr ""
"Numero di mesi di conservazione dettagliata della cronologia dei giri "
"(tempo, auto, circuito). Oltre tale periodo, viene archiviata come "
"riepilogo mensile compatto anziché eliminata."

#: app/routes/admin.py:587
msgid "Port HTTP de l'API du serveur (défaut 8081)"
msgstr "Porta HTTP dell'API del server (default 8081)"

#: app/routes/admin.py:588
msgid "Hôte TCP ACE EVO (défaut 127.0.0.1)"
msgstr "Host TCP ACE EVO (default 127.0.0.1)"

#: app/routes/admin.py:589
msgid "Port TCP ACE EVO (défaut 9700)"
msgstr "Porta TCP ACE EVO (default 9700)"

#: app/routes/admin.py:590
msgid "Dossier d'installation ACE EVO"
msgstr "Cartella di installazione di ACE EVO"

#: app/routes/admin.py:591
msgid "Dossier des fichiers de configuration JSON"
msgstr "Cartella dei file di configurazione JSON"

#: app/routes/admin.py:592
msgid ""
"Nom du serveur affiché dans la liste des serveurs ACE EVO (commun à "
"toutes les configs)"
msgstr ""
"Nome del server visualizzato nell'elenco server ACE EVO (comune a tutte "
"le configurazioni)"

#: app/routes/admin.py:593
msgid "Nombre maximum de joueurs simultanés (1–128, défaut 8)"
msgstr "Numero massimo di giocatori simultanei (1–128, default 8)"

#: app/routes/admin.py:594
msgid ""
"Port TCP du serveur de jeu (défaut 9700) — doit correspondre aux règles "
"firewall"
msgstr ""
"Porta TCP del server di gioco (default 9700) — deve corrispondere alle "
"regole del firewall"

#: app/routes/admin.py:595
msgid ""
"Port UDP du serveur de jeu (défaut 9700) — généralement identique au port"
" TCP"
msgstr ""
"Porta UDP del server di gioco (default 9700) — solitamente identica alla "
"porta TCP"

#: app/routes/admin.py:596
msgid ""
"Mot de passe d'accès au serveur pour les pilotes. Laisser vide = accès "
"libre"
msgstr ""
"Password di accesso al server per i piloti. Lasciare vuoto = accesso "
"libero"

#: app/routes/admin.py:597
msgid ""
"Mot de passe admin serveur (commandes /kick, /next, etc.) — utilisé aussi"
" par le bot TCP"
msgstr ""
"Password admin del server (comandi /kick, /next, ecc.) — usata anche dal "
"bot TCP"

#: app/routes/admin.py:598
msgid "Chemin vers le fichier entry_list.ini (laisser vide si non utilisé)"
msgstr "Percorso del file entry_list.ini (lasciare vuoto se non utilizzato)"

#: app/routes/admin.py:599
msgid ""
"Dossier de sortie des résultats de session (laisser vide = dossier par "
"défaut)"
msgstr ""
"Cartella di output dei risultati di sessione (lasciare vuoto = cartella "
"predefinita)"

#: app/routes/admin.py:600
msgid ""
"Steam ID 64-bit du compte bot — le bot se connecte au serveur avec ce "
"compte. Laisser vide pour désactiver le bot."
msgstr ""
"Steam ID a 64 bit dell'account bot — il bot si connette al server con "
"questo account. Lasciare vuoto per disattivare il bot."

#: app/routes/admin.py:601
msgid "Voiture utilisée par le bot pour rejoindre la session."
msgstr "Auto utilizzata dal bot per unirsi alla sessione."

#: app/routes/admin.py:602
msgid ""
"Activer les droits admin pour le bot (true/false). Le mot de passe est lu"
" automatiquement depuis la config serveur active."
msgstr ""
"Attiva i diritti admin per il bot (true/false). La password viene letta "
"automaticamente dalla configurazione server attiva."

#: app/routes/admin.py:603
#, python-brace-format
msgid ""
"Message de bienvenue envoyé à chaque connexion. Variable : {name}. "
"Laisser vide pour désactiver."
msgstr ""
"Messaggio di benvenuto inviato ad ogni connessione. Variabile: {name}. "
"Lasciare vuoto per disattivare."

#: app/routes/admin.py:604
#, python-brace-format
msgid ""
"Message Discord envoyé si DISCORD_INVITE_URL est défini. Variables : "
"{name}, {discord_url}. Laisser vide pour désactiver."
msgstr ""
"Messaggio Discord inviato se DISCORD_INVITE_URL è impostato. Variabili: "
"{name}, {discord_url}. Lasciare vuoto per disattivare."

#: app/routes/admin.py:605
#, python-brace-format
msgid ""
"Message site envoyé si PANEL_URL est défini. Variables : {name}, "
"{site_url}. Laisser vide pour désactiver."
msgstr ""
"Messaggio del sito inviato se PANEL_URL è impostato. Variabili: {name}, "
"{site_url}. Lasciare vuoto per disattivare."

#: app/routes/admin.py:606
msgid ""
"Pré-remplit le formulaire de mise à jour. Le mot de passe est saisi au "
"moment de la mise à jour, jamais stocké."
msgstr ""
"Precompila il modulo di aggiornamento. La password viene inserita al "
"momento dell'aggiornamento, mai memorizzata."

#: app/routes/admin.py:607
msgid "Webhook principal — démarrage, arrêt, crash du serveur"
msgstr "Webhook principale — avvio, arresto, crash del server"

#: app/routes/admin.py:608
msgid "Webhook pilotes — connexions, déconnexions, changements de véhicule"
msgstr "Webhook piloti — connessioni, disconnessioni, cambi veicolo"

#: app/routes/admin.py:609
msgid "Webhook course — meilleur tour, actions admin (kick, pénalités…)"
msgstr "Webhook gara — miglior giro, azioni admin (kick, penalità…)"

#: app/routes/admin.py:610
msgid ""
"Envoie sur le webhook course un récapitulatif à la fin de chaque session "
": podium, meilleur tour, incidents et sanctions (true/false, désactivé "
"par défaut)."
msgstr ""
"Invia al webhook gara un riepilogo alla fine di ogni sessione: podio, "
"giro migliore, incidenti e penalità (true/false, disattivato di default)."

#: app/routes/admin.py:611
msgid "Lien d'invitation Discord affiché sur le panel"
msgstr "Link di invito Discord mostrato sul pannello"

#: app/routes/admin.py:612
msgid ""
"Mention envoyée avec les événements serveur (ex: @here ou <@&123456789>)."
" Laisser vide pour désactiver."
msgstr ""
"Menzione inviata con gli eventi del server (es: @here o <@&123456789>). "
"Lasciare vuoto per disattivare."

#: app/routes/admin.py:613
msgid "Mention envoyée avec les connexions joueurs. Laisser vide pour désactiver."
msgstr ""
"Menzione inviata con le connessioni dei giocatori. Lasciare vuoto per "
"disattivare."

#: app/routes/admin.py:614
msgid "Mention envoyée avec les événements course. Laisser vide pour désactiver."
msgstr "Menzione inviata con gli eventi gara. Lasciare vuoto per disattivare."

#: app/routes/admin.py:615
#, python-brace-format
msgid "Titre embed — Serveur démarré. Variables : {config}, {mode}, {circuit}"
msgstr "Titolo embed — Server avviato. Variabili: {config}, {mode}, {circuit}"

#: app/routes/admin.py:616
#, python-brace-format
msgid "Titre embed — Serveur arrêté. Variables : {config}"
msgstr "Titolo embed — Server arrestato. Variabili: {config}"

#: app/routes/admin.py:617
#, python-brace-format
msgid "Titre embed — Crash détecté. Variables : {config}"
msgstr "Titolo embed — Crash rilevato. Variabili: {config}"

#: app/routes/admin.py:618
#, python-brace-format
msgid ""
"Titre embed — Connexion joueur. Variables : {name}, {num}, {car}, "
"{steam_id}"
msgstr ""
"Titolo embed — Connessione giocatore. Variabili: {name}, {num}, {car}, "
"{steam_id}"

#: app/routes/admin.py:619
#, python-brace-format
msgid ""
"Titre embed — Déconnexion joueur. Variables : {name}, {duration}, "
"{steam_id}"
msgstr ""
"Titolo embed — Disconnessione giocatore. Variabili: {name}, {duration}, "
"{steam_id}"

#: app/routes/admin.py:620
#, python-brace-format
msgid ""
"Titre embed — Changement de véhicule. Variables : {name}, {num}, "
"{old_car}, {new_car}"
msgstr ""
"Titolo embed — Cambio veicolo. Variabili: {name}, {num}, {old_car}, "
"{new_car}"

#: app/routes/admin.py:621
#, python-brace-format
msgid ""
"Titre embed — Meilleur tour serveur. Variables : {name}, {lap}, {car}, "
"{circuit}"
msgstr ""
"Titolo embed — Miglior giro del server. Variabili: {name}, {lap}, {car}, "
"{circuit}"

#: app/routes/admin.py:622
#, python-brace-format
msgid ""
"Titre embed — Action admin. Variables : {action}, {target}, {admin}, "
"{detail}"
msgstr ""
"Titolo embed — Azione admin. Variabili: {action}, {target}, {admin}, "
"{detail}"

#: app/routes/admin.py:623
#, python-brace-format
msgid "Titre embed — Fin de session. Variables : {session}, {circuit}"
msgstr "Titolo embed — Fine sessione. Variabili: {session}, {circuit}"

#: app/routes/admin.py:624
msgid "Serveur SMTP (laisser vide pour désactiver les emails)"
msgstr "Server SMTP (lasciare vuoto per disattivare le email)"

#: app/routes/admin.py:625
msgid "Port SMTP (ex: 587 ou 465)"
msgstr "Porta SMTP (es: 587 o 465)"

#: app/routes/admin.py:626
msgid "TLS : true ou false"
msgstr "TLS: true o false"

#: app/routes/admin.py:627
msgid "Identifiant SMTP"
msgstr "Nome utente SMTP"

#: app/routes/admin.py:628
msgid "Mot de passe SMTP"
msgstr "Password SMTP"

#: app/routes/admin.py:629
msgid "Adresse expéditeur"
msgstr "Indirizzo mittente"

#: app/routes/admin.py:630
msgid "Adresse(s) admin pour les notifications (séparées par virgule)"
msgstr "Indirizzo/i admin per le notifiche (separati da virgola)"

#: app/routes/admin.py:631
msgid "Langue par défaut : fr, en, es, de, it"
msgstr "Lingua predefinita: fr, en, es, de, it"

#: app/routes/admin.py:684
msgid ""
"Contrôle d'accès au serveur de jeu (liste blanche des pilotes approuvés, "
"bannissements, lest et restricteur par SteamID) : se règle dans la page "
"Accès, désactivé par défaut."
msgstr ""
"Controllo accessi al server di gioco (whitelist dei piloti approvati, "
"ban, zavorra e restrittore per SteamID): si imposta nella pagina Accesso,"
" disattivato di default."

#: app/routes/admin.py:685
msgid ""
"Réserve le serveur aux pilotes approuvés (page Accès, désactivé par "
"défaut)."
msgstr ""
"Riserva il server ai piloti approvati (pagina Accesso, disattivato di "
"default)."

#: app/routes/admin.py:688
msgid ""
"Récapitulatif Discord à la fin de chaque session (podium, meilleur tour, "
"incidents, sanctions) : interrupteur dans Paramètres → Notifications, "
"désactivé par défaut."
msgstr ""
"Riepilogo Discord a fine sessione (podio, giro migliore, incidenti, "
"penalità): interruttore in Impostazioni → Notifiche, disattivato di "
"default."

#: app/routes/admin.py:691
msgid ""
"Dossier de session Steam à monter si le panel est lancé via systemd ou "
"sudo sans -E (sinon ça reste vide et $HOME est utilisé, comme avant)."
msgstr ""
"Cartella di sessione Steam da montare se il pannello viene avviato "
"tramite systemd o sudo senza -E (altrimenti resta vuota e viene usata "
"$HOME, come prima)."

#: app/routes/admin.py:848 app/routes/admin.py:1244
