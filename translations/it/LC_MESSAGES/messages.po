#: app/routes/admin.py:1161
msgid ""
"Cet identifiant est déjà utilisé par un compte admin — renomme le pilote "
"ou l'admin existant."
msgstr ""
"Questo identificativo è già usato da un account admin — rinomina il "
"pilota o l'admin esistente."

#: app/routes/admin.py:1174
msgid "Requête invalide"
msgstr "Richiesta non valida"

#: app/routes/admin.py:1194 app/routes/public.py:214
msgid "Cet email est déjà utilisé."
msgstr "Questa email è già in uso."

#: app/routes/admin.py:1198
msgid "Email mis à jour."
msgstr "Email aggiornata."

#: app/routes/admin.py:1242 app/routes/admin.py:1331
msgid "Le nom est requis."
msgstr "Il nome è obbligatorio."

#: app/routes/admin.py:1246
#, python-format
msgid "Le port %(port)d est déjà utilisé par un autre serveur."
msgstr "La porta %(port)d è già in uso da un altro server."

#: app/routes/admin.py:1248
#, python-format
msgid "Un container Docker nommé '%(name)s' existe déjà."
msgstr "Esiste già un container Docker chiamato '%(name)s'."

#: app/routes/admin.py:1271
#, python-format
msgid "Erreur lors de la création du container : %(err)s"
msgstr "Errore nella creazione del container: %(err)s"

#: app/routes/admin.py:1295
#, python-format
msgid "Serveur '%(name)s' créé avec succès."
msgstr "Server '%(name)s' creato con successo."

#: app/routes/admin.py:1304
msgid "Le serveur principal ne peut pas être désactivé."
msgstr "Il server principale non può essere disabilitato."

#: app/routes/admin.py:1307 app/routes/admin.py:1328 app/routes/admin.py:1363
msgid "Serveur introuvable."
msgstr "Server non trovato."

#: app/routes/admin.py:1310
#, python-format
msgid "Serveur '%(name)s' activé."
msgstr "Server '%(name)s' abilitato."

#: app/routes/admin.py:1310
#, python-format
msgid "Serveur '%(name)s' désactivé."
msgstr "Server '%(name)s' disabilitato."

#: app/routes/admin.py:1342
#, python-format
msgid ""
"Serveur renommé en '%(name)s'. Le nom affiché dans le navigateur de "
"serveurs du jeu ne sera mis à jour qu'au prochain redémarrage."
msgstr ""
"Server rinominato in '%(name)s'. Il nome mostrato nel browser server del "
"gioco verrà aggiornato solo al prossimo riavvio."

#: app/routes/admin.py:1360
msgid "Le serveur principal ne peut pas être supprimé."
msgstr "Il server principale non può essere eliminato."

#: app/routes/admin.py:1383 app/routes/admin.py:1384
#, python-format
msgid "Serveur '%(name)s' supprimé."
msgstr "Server '%(name)s' eliminato."

#: app/routes/admin.py:1509
msgid "Fichier trop volumineux (max 3 Go)"
msgstr "File troppo grande (max 3 GB)"

#: app/routes/admin.py:1532 app/routes/admin.py:1545
msgid "Mod introuvable"
msgstr "Mod non trovata"

#: app/routes/admin.py:1551 app/routes/admin.py:1553 app/routes/admin.py:1555
msgid "Tag invalide"
msgstr "Tag non valido"

#: app/routes/admin.py:1561
msgid "PI invalide"
msgstr "PI non valido"

#: app/routes/auth.py:64
msgid "Le mot de passe doit contenir au moins 10 caractères."
msgstr "La password deve contenere almeno 10 caratteri."

#: app/routes/auth.py:66
msgid "Le mot de passe doit contenir au moins une majuscule."
msgstr "La password deve contenere almeno una lettera maiuscola."

#: app/routes/auth.py:68
msgid "Le mot de passe doit contenir au moins une minuscule."
msgstr "La password deve contenere almeno una lettera minuscola."

#: app/routes/auth.py:70
msgid "Le mot de passe doit contenir au moins un chiffre."
msgstr "La password deve contenere almeno una cifra."

