msgstr "Sin dirección de destinatario"

#: app/routes/admin.py:332 app/routes/admin.py:335
msgid "Email envoyé avec succès"
msgstr "Correo enviado con éxito"

#: app/routes/admin.py:333 app/routes/admin.py:337
