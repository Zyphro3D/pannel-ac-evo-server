msgstr "Imposible: debe quedar al menos un superadmin activo."

#: app/routes/admin.py:1071
msgid "Compte mis à jour."
msgstr "Cuenta actualizada."

#: app/routes/admin.py:1081 app/routes/admin.py:1133
msgid "Compte introuvable"
msgstr "Cuenta no encontrada"

#: app/routes/admin.py:1085
msgid "Dernier superadmin actif — impossible de désactiver"
msgstr "Último superadmin activo — no se puede desactivar"

#: app/routes/admin.py:1087
msgid "Impossible de vous désactiver vous-même"
msgstr "No puede desactivarse a sí mismo"

#: app/routes/admin.py:1102 app/routes/admin.py:1136
msgid "Impossible de supprimer votre propre compte."
msgstr "No puede eliminar su propia cuenta."

#: app/routes/admin.py:1107 app/routes/admin.py:1140
msgid "Impossible : il doit rester au moins un superadmin."
msgstr "Imposible: debe quedar al menos un superadmin."

#: app/routes/admin.py:1111
msgid "Compte supprimé."
msgstr "Cuenta eliminada."

#: app/routes/admin.py:1127
msgid "Rôle invalide"
msgstr "Rol inválido"

#: app/routes/admin.py:1156
msgid "Pilote introuvable"
msgstr "Piloto no encontrado"

#: app/routes/admin.py:1161
msgid ""
"Cet identifiant est déjà utilisé par un compte admin — renomme le pilote "
"ou l'admin existant."
msgstr ""
"Este identificador ya lo usa una cuenta de administrador: cambia el "
"nombre del piloto o del administrador existente."

#: app/routes/admin.py:1174
msgid "Requête invalide"
msgstr "Solicitud inválida"

#: app/routes/admin.py:1194 app/routes/public.py:214
msgid "Cet email est déjà utilisé."
msgstr "Este email ya está en uso."

#: app/routes/admin.py:1198
msgid "Email mis à jour."
msgstr "Correo actualizado."

#: app/routes/admin.py:1242 app/routes/admin.py:1331
msgid "Le nom est requis."
msgstr "El nombre es obligatorio."

#: app/routes/admin.py:1246
#, python-format
msgid "Le port %(port)d est déjà utilisé par un autre serveur."
msgstr "El puerto %(port)d ya está siendo usado por otro servidor."

#: app/routes/admin.py:1248
#, python-format
msgid "Un container Docker nommé '%(name)s' existe déjà."
msgstr "Ya existe un contenedor Docker llamado '%(name)s'."

#: app/routes/admin.py:1271
#, python-format
msgid "Erreur lors de la création du container : %(err)s"
msgstr "Error al crear el contenedor: %(err)s"

#: app/routes/admin.py:1295
#, python-format
msgid "Serveur '%(name)s' créé avec succès."
msgstr "Servidor '%(name)s' creado con éxito."

#: app/routes/admin.py:1304
msgid "Le serveur principal ne peut pas être désactivé."
msgstr "El servidor principal no puede desactivarse."

#: app/routes/admin.py:1307 app/routes/admin.py:1328 app/routes/admin.py:1363
msgid "Serveur introuvable."
msgstr "Servidor no encontrado."

#: app/routes/admin.py:1310
#, python-format
msgid "Serveur '%(name)s' activé."
msgstr "Servidor '%(name)s' activado."

#: app/routes/admin.py:1310
#, python-format
msgid "Serveur '%(name)s' désactivé."
msgstr "Servidor '%(name)s' desactivado."

#: app/routes/admin.py:1342
#, python-format
msgid ""
"Serveur renommé en '%(name)s'. Le nom affiché dans le navigateur de "
"serveurs du jeu ne sera mis à jour qu'au prochain redémarrage."
msgstr ""
"Servidor renombrado a '%(name)s'. El nombre mostrado en el navegador de "
"servidores del juego solo se actualizará en el próximo reinicio."

#: app/routes/admin.py:1360
msgid "Le serveur principal ne peut pas être supprimé."
msgstr "El servidor principal no puede eliminarse."

#: app/routes/admin.py:1383 app/routes/admin.py:1384
#, python-format
msgid "Serveur '%(name)s' supprimé."
msgstr "Servidor '%(name)s' eliminado."

#: app/routes/admin.py:1509
msgid "Fichier trop volumineux (max 3 Go)"
msgstr "Archivo demasiado grande (máx. 3 GB)"

#: app/routes/admin.py:1532 app/routes/admin.py:1545
msgid "Mod introuvable"
msgstr "Mod no encontrado"

#: app/routes/admin.py:1551 app/routes/admin.py:1553 app/routes/admin.py:1555
msgid "Tag invalide"
msgstr "Etiqueta inválida"

#: app/routes/admin.py:1561
msgid "PI invalide"
msgstr "PI inválido"

#: app/routes/auth.py:64
msgid "Le mot de passe doit contenir au moins 10 caractères."
msgstr "La contraseña debe tener al menos 10 caracteres."

#: app/routes/auth.py:66
msgid "Le mot de passe doit contenir au moins une majuscule."
msgstr "La contraseña debe contener al menos una mayúscula."

#: app/routes/auth.py:68
msgid "Le mot de passe doit contenir au moins une minuscule."
